# === LLM (OpenRouter) ===
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# === Wake Word (Picovoice Porcupine) ===
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORD=jarvis
# Когда натренируешь кастомный wake word на console.picovoice.ai:
# PORCUPINE_KEYWORD_PATH=data/models/reze_wake_word_windows.ppn
WAKE_WORD_SENSITIVITY=0.5

# === Audio / STT ===
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
STT_MODEL=medium
STT_LANGUAGE=ru

# === TTS / Voice ===
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
TTS_LANGUAGE=ru
TTS_EMOTION=neutral
TTS_VOICE=ru-RU-SvetlanaNeural
VOICE_SAMPLE_PATH=

# === Telegram ===
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# === Weather ===
# Бесплатный ключ: https://home.openweathermap.org/users/sign_up (Free tier, 1000 req/day)
OPENWEATHER_API_KEY=

# === System ===
ASSISTANT_NAME=Reze
LOG_LEVEL=INFO
DATA_DIR=data
HF_HUB_DISABLE_SYMLINKS_WARNING=1
